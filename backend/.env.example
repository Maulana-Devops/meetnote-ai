# Core settings
# APP_NAME: Nama aplikasi yang ditampilkan
# DEBUG:  Set true hanya untuk development (auto-reload); default rilis = false.
DEBUG=false
APP_NAME=MeetNote AI

# Database (SQLite)
# Jalur file database relatif terhadap folder backend/
DATABASE_URL=sqlite:///./meetnote.db
# Jalankan migrasi Alembic saat startup. Biarkan true untuk deployment.
RUN_DB_MIGRATIONS=true

# Port server backend
BACKEND_PORT=8000
# Origin frontend yang diizinkan, dipisah koma (default: Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sprint 2 — audio hasil rekaman browser
# Relatif terhadap folder backend/ sau absolut.
STORAGE_DIR=../storage
# Batas ukuran satu rekaman dalam byte (25 MB).
MAX_AUDIO_FILE_BYTES=26214400
# Batas durasi metadata rekaman dalam detik (24 jam); menolak nilai inf/1e999.
MAX_AUDIO_DURATION_SECONDS=86400

# ---- Retry provider untuk job background ----
# Hanya error sementara (429, timeout, gangguan server) yang diulang.
# attempts=1 mematikan retry. Backoff: base * 2^(attempt-1), dibatasi max,
# dikali jitter 0.5-1.0. Tidak ada secret atau pesan error mentah di log.
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_BASE_SECONDS=1.0
PROVIDER_RETRY_MAX_SECONDS=8.0

# ---- Sprint 4 — Speech-to-Text ----
# Provider: mock | openai | faster_whisper | local | whisper_cpp
# `mock` menghasilkan teks berawalan [MOCK] untuk pengujian lokal, BUKAN hasil sungguhan.
STT_PROVIDER=openai
# Rahasia: HANYA di backend. Jangan pernah memakai prefix VITE_ untuk nilai ini.
STT_API_KEY=
STT_API_BASE_URL=https://api.openai.com/v1
# whisper-1 + verbose_json dipakai untuk segmen bertimestamp.
STT_MODEL=whisper-1
STT_TIMEOUT_SECONDS=120
# Batas dokumen provider (25 MB).
STT_MAX_FILE_BYTES=26214400

# ---- Fase 1 — STT lokal & Bahasa Indonesia ----
# Untuk on-prem tanpa API key: STT_PROVIDER=faster_whisper
# Provider: mock | openai | faster_whisper | local | whisper_cpp
STT_LANGUAGE=id
STT_LOCAL_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_VAD=true
STT_WORD_TIMESTAMPS=true
# Relatif terhadap folder backend/. Model tidak masuk Git.
STT_MODEL_DIR=../models/faster-whisper
WHISPER_CPP_BASE_URL=http://127.0.0.1:8080/v1
WHISPER_CPP_MODEL=whisper.cpp
# Kamus organisasi; format bentuk-asr=bentuk-baku per baris.
INDONESIAN_VOCAB_PATH=../config/indonesian-vocab.txt

# ---- Sprint 5 — Speaker Diarization ----
# Provider: mock | deepgram | pyannote
# `mock` hanya untuk pengujian/percobaan lokal, BUKAN hasil diarisasi sungguhan.
DIARIZATION_PROVIDER=deepgram
# Rahasia: HANYA di backend. Jangan pernah memakai prefix VITE_ untuk nilai ini.
DIARIZATION_API_KEY=
DIARIZATION_API_BASE_URL=https://api.deepgram.com/v1
# Model STT yang kompatibel dengan diarize_model.
DIARIZATION_MODEL=nova-3
# latest | v1 | v2 (batch). Deepgram menyarankan `latest`.
DIARIZATION_DIARIZE_MODEL=latest
DIARIZATION_TIMEOUT_SECONDS=180
# Batas terdokumentasi Deepgram: 2 GB.
DIARIZATION_MAX_FILE_BYTES=2147483648
# Ambang pemetaan speaker ke segmen.
DIARIZATION_MIN_OVERLAP_RATIO=0.5
DIARIZATION_MIN_OVERLAP_SECONDS=0
# Opsional: pyannote community-1 (pilih DIARIZATION_PROVIDER=pyannote).
# Token HF HANYA di environment backend; jangan pernah commit nilainya.
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_TOKEN=
PYANNOTE_METRICS_ENABLED=false

# ---- Sprint 7 — AI Summarization ----
# Provider: openai | mock
# `mock` menghasilkan ringkasan berawalan [MOCK], BUKAN hasil AI sungguhan.
LLM_PROVIDER=openai
# Rahasia: HANYA di backend. Jangan pernah memakai prefix VITE_ untuk nilai ini.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
# Model harus mendukung Structured Outputs JSON schema (strict=true).
LLM_MODEL=gpt-4o-mini-2024-08-06
# Fase 1: default Bahasa Indonesia. Kosong = ikuti bahasa transkrip.
LLM_OUTPUT_LANGUAGE=Indonesia
LLM_TIMEOUT_SECONDS=90
# Batas karakter transkrip yang dikirim dalam satu request.
LLM_MAX_INPUT_CHARACTERS=24000