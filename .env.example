# Contoh konfigurasi environment variables untuk MeetNote AI.
# Salin file ini menjadi `.env` di folder backend/ dan frontend/ lalu sesuaikan.
# JANGAN commit file .env ke Git.

# ---- Backend ----
APP_NAME=MeetNote AI
# Set true hanya untuk development (auto-reload uvicorn).
DEBUG=false
DATABASE_URL=sqlite:///./meetnote.db
# Jalankan migrasi Alembic saat startup. Biarkan true untuk deployment.
RUN_DB_MIGRATIONS=true
BACKEND_PORT=8000
# Origin frontend yang diizinkan, dipisah koma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=../storage
MAX_AUDIO_FILE_BYTES=26214400

# ---- Sprint 4 — Speech-to-Text (backend saja) ----
# JANGAN taruh API key di frontend atau variabel VITE_ apa pun.
STT_PROVIDER=openai
STT_API_KEY=
STT_API_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_TIMEOUT_SECONDS=120
STT_MAX_FILE_BYTES=26214400

# ---- Fase 1 — STT lokal & Bahasa Indonesia (backend saja) ----
# Untuk on-prem tanpa API key: STT_PROVIDER=faster_whisper
# Provider: mock | openai | faster_whisper | local | whisper_cpp
STT_LANGUAGE=id
STT_LOCAL_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_VAD=true
STT_WORD_TIMESTAMPS=true
STT_MODEL_DIR=../models/faster-whisper
WHISPER_CPP_BASE_URL=http://127.0.0.1:8080/v1
WHISPER_CPP_MODEL=whisper.cpp
INDONESIAN_VOCAB_PATH=../config/indonesian-vocab.txt

# ---- Sprint 5 — Speaker Diarization (backend saja) ----
# JANGAN taruh API key di frontend atau variabel VITE_ apa pun.
DIARIZATION_PROVIDER=deepgram
DIARIZATION_API_KEY=
DIARIZATION_API_BASE_URL=https://api.deepgram.com/v1
DIARIZATION_MODEL=nova-3
DIARIZATION_DIARIZE_MODEL=latest
DIARIZATION_TIMEOUT_SECONDS=180
DIARIZATION_MAX_FILE_BYTES=2147483648
DIARIZATION_MIN_OVERLAP_RATIO=0.5
DIARIZATION_MIN_OVERLAP_SECONDS=0
# Opsional: pyannote community-1 (pilih DIARIZATION_PROVIDER=pyannote).
# Token HF HANYA di environment backend.
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_TOKEN=
PYANNOTE_METRICS_ENABLED=false

# ---- Sprint 7 — AI Summarization (backend saja) ----
# JANGAN taruh API key di frontend atau variabel VITE_ apa pun.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini-2024-08-06
LLM_OUTPUT_LANGUAGE=Indonesia
LLM_TIMEOUT_SECONDS=90
LLM_MAX_INPUT_CHARACTERS=24000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000